{
  "extends": "@tsconfig/node24/tsconfig.json", // --> Extende o tsconfig do node 24
  "compilerOptions": {
    "rootDir": "src", // --> Tudo que estiver dentro da src em TS vai ser compilado para a pasta dist
    "outDir" : "dist", // Será compilado para a pasta dist em JS
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}

